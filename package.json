{
  "name": "gameai-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:data": "node --import tsx scripts/validate-services.ts && node --import tsx scripts/validate-decision-data.ts && node --import tsx scripts/validate-recommendation-coverage.ts",
    "check:affiliates": "node --import tsx scripts/validate-affiliates.ts",
    "check:stale": "node --import tsx scripts/check-stale-data.ts",
    "check:links": "node --import tsx scripts/check-links.ts",
    "check:sitemap": "node --import tsx scripts/check-sitemap.ts",
    "affiliate:set": "node --import tsx scripts/set-affiliate.ts && npm run affiliate:sync",
    "affiliate:sync": "node --import tsx scripts/sync-affiliates.ts",
    "quality": "npm run affiliate:sync && npm run lint && npm run typecheck && npm test && npm run validate:data && npm run check:affiliates && npm run check:sitemap && npm run validate:content",
    "test:e2e": "playwright test",
    "validate:content": "node --import tsx scripts/validate-articles.ts"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.2",
    "jsdom": "27.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.0.6"
  }
}
