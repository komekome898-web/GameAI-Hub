# The sole production origin. Keep this exact HTTPS URL without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://game-ai-hub.vercel.app

# Optional, server-only Cloudflare Workers AI interpreter. Leave unset to use
# the deterministic local interpreter. Never prefix these with NEXT_PUBLIC_.
PROJECT_INTERPRETER_PROVIDER=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
